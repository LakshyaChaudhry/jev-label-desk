# OpenRouter key for the Decisions API (server-side only).
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional. Set to 1 to skip live API calls and return deterministic labels.
# Useful for UI/dev without a key.
JEV_MOCK=0

# Optional overrides (defaults shown).
# OPENROUTER_DECISIONS_URL=https://openrouter.ai/api/alpha/decisions
# JEV_MODEL=~typesafe/jev-latest
# JEV_FALLBACK_MODEL=typesafe/jev-1.13
# JEV_CONCURRENCY=4
